@AbapCatalog.sqlViewName: 'ZEO_SPFLI_1'
@AbapCatalog.compiler.compareFilter: true
@AbapCatalog.preserveKey: true
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Airline details'
@OData.publish: true
@Analytics.dataCategory: #CUBE
@VDM.viewType: #COMPOSITE
@Metadata.allowExtensions: true
@Search.searchable: true
@ObjectModel.semanticKey: ['Airline_code','Flight_Connection_Number']
@UI.headerInfo:
{ typeName: 'Connection',typeNamePlural: 'Connection' , 
title:{type: #STANDARD, value: 'Airline_name' },
description:{ type: #STANDARD , value: 'Airline_code' }
 } 
 
define view Zeo_spfli_updated as select from spfli as _connection
association[1] to scarr as _carrier on $projection.Airline_code = _carrier.carrid 
association[1..*] to Z_I_sflight_details as _flight on $projection.Airline_code = _flight.Carrier_ID
                                           and $projection.Flight_Connection_Number = _flight.ConnID 
{
 
   key _connection.carrid as Airline_code,
    
   key _connection.connid as Flight_Connection_Number,
    
    @ObjectModel.mandatory: true
    @Search.defaultSearchElement: true
    @Search.fuzzinessThreshold:0.5
    @ObjectModel.text.element: ['Airline_code']
    @Consumption.valueHelpDefinition: [{entity.name: 'Zeo_CarrierSH',entity.element: 'carrname' }]
    @Consumption.filter:{mandatory: true,defaultValue:'American Airlines' , multipleSelections: true,selectionType:#SINGLE }
    _carrier.carrname     as Airline_name,
    
    _carrier.url          as weburl,
    
    _connection.countryfr as Country_Key,
    
    _connection.cityfrom  as Departure_city,
    
    @ObjectModel.text.element: ['Departure_city']
    _connection.airpfrom  as Departure_Airport,
    
    _connection.countryto as Country_Key2,
    
    @ObjectModel.text.element: ['Destination_airport']
    _connection.cityto    as Arrival_city,
    
    @ObjectModel.text.element: ['Arrival_city']
     _connection.airpto   as Destination_airport,
    
    _connection.deptime   as Departure_time,
    
    _connection.arrtime   as Arrival_time,
    
   _connection.distance   as Distance,
    
     _connection.distid   as Distance_id,
    
     _connection.fltype   as Flight_type,
    
     _connection.period   as Journey_Duration,
    
    //Public association 
     _carrier,
     _flight
}
    
